# Shared settings for every recording (sourced by the other tapes).
Set Shell "bash"
Set FontFamily "DejaVu Sans Mono"
Set FontSize 22
Set Width 1200
Set LineHeight 1.25
Set Padding 28
Set Margin 0
Set WindowBar ""
Set BorderRadius 0
Set Framerate 24
Set TypingSpeed 28ms
Set CursorBlink false
Set Theme { "name": "telegraph", "black": "#0d1117", "red": "#f85149", "green": "#3fb950", "yellow": "#d29922", "blue": "#58a6ff", "magenta": "#bc8cff", "cyan": "#3fb6c8", "white": "#c9d1d9", "brightBlack": "#6e7681", "brightRed": "#ff7b72", "brightGreen": "#56d364", "brightYellow": "#e3b341", "brightBlue": "#79c0ff", "brightMagenta": "#d2a8ff", "brightCyan": "#56d4dd", "brightWhite": "#f0f6fc", "background": "#0d1117", "foreground": "#c9d1d9", "selection": "#264f78", "cursor": "#3fb6c8" }
