<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Telegraph node as a macOS launchd agent.
    install: sh scripts/install-service.sh node1   (writes this with paths filled in)
    status:  launchctl print gui/$(id -u)/com.ao3575911.telegraph.node1
    logs:    tail -f ~/Library/Logs/telegraph-node1.log
  The token is read from ~/.config/telegraph/node1.env (mode 0600) by the
  supervisor script, never stored in this plist.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ao3575911.telegraph.@NODE@</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>@SUPERVISE@</string>
    <string>@ENVFILE@</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>@LOG@</string>
  <key>StandardErrorPath</key><string>@LOG@</string>
</dict>
</plist>
